{
  "name": "vouch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Proves what a schema change breaks, and shows you the client that breaks.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome ci .",
    "check:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
